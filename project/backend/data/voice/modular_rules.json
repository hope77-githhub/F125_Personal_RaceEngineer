      "bandpass_low_hz": 350,
      "bandpass_high_hz": 3400,
      "distortion_gain": 1.15,
      "noise_floor_level": 0.015,
      "radio_bleep_fx": true
    }
  },
  "templates": {
    "gap_ahead": {
      "prefix": {
