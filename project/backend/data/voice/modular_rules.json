      "number_pattern": "{s}",
      "suffix": {
        "file": "suffixes/seconds.mp3",
        "text": " seconds."
      }
    },
    "pace_gain": {
      "prefix": {
        "file": "prefixes/pace_gain.mp3",
        "text": "Pace improved by "
      },
      "number_pattern": "{s}",
      "suffix": {
        "file": "suffixes/seconds_rhythm.mp3",
        "text": " seconds, strong rhythm."
