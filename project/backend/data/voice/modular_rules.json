        "file": "suffixes/seconds.mp3",
        "text": " seconds."
      },
      "overtake_suffix": {
        "file": "suffixes/seconds_overtake.mp3",
        "text": " seconds, overtake mode available."
      }
    },
    "gap_leader": {
      "prefix": {
        "file": "prefixes/gap_leader.mp3",
        "text": "Gap to the leader is "
      },
      "number_pattern": "{s}",
      "suffix": {
        "file": "suffixes/seconds.mp3",
        "text": " seconds."
      }
    },
    "gap_teammate": {
      "prefix": {
        "file": "prefixes/gap_teammate.mp3",
        "text": "Gap to your teammate is "
      },
      "number_pattern": "{s}",
      "suffix": {
        "file": "suffixes/seconds.mp3",
        "text": " seconds."
      }
